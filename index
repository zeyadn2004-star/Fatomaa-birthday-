
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#160b29">
<title>هدية فاطيما السرية ❤️</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Amiri:wght@400;700&display=swap');

:root {
  --gold: #ffda91;
  --pink: #ff9fc9;
  --purple: #a879ff;
  --bg: #10091d;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  min-height: 100vh;
  color: #fff7ff;
  font-family: 'Cairo', Arial, sans-serif;
  background:
    radial-gradient(ellipse at 50% 0%, #422052 0%, transparent 55%),
    linear-gradient(160deg, #10091d, #21102f 55%, #10091d);
  overflow-x: hidden;
}

button, input { font: inherit; }

button { cursor: pointer; }

#stars {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.star {
  position: absolute;
  color: white;
  opacity: .65;
  animation: twinkle 2.5s infinite alternate;
}

@keyframes twinkle {
  from { opacity: .15; transform: scale(.7); }
  to { opacity: .95; transform: scale(1.2); }
}

#lockScreen {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px;
  text-align: center;
  background:
    radial-gradient(ellipse at 50% 20%, #60336f, transparent 65%),
    #10091d;
  transition: opacity .8s;
}

.lock-card {
  width: 100%;
  max-width: 390px;
  padding: 30px 22px;
  border: 1px solid #ffda9170;
  border-radius: 28px;
  background: #ffffff0b;
  box-shadow: 0 0 60px #b46aff18;
  backdrop-filter: blur(12px);
}

.lock-icon {
  font-size: 75px;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  50% { transform: translateY(-12px) rotate(4deg); }
}

.gold {
  color: var(--gold);
  text-shadow: 0 0 20px #ffc95d40;
}

.subtitle {
  color: #e8d5ef;
  line-height: 2;
  font-size: 15px;
}

#password {
  width: 100%;
  padding: 15px;
  margin: 14px 0 10px;
  border-radius: 15px;
  border: 1px solid #ffda91a0;
  outline: none;
  background: #160d24;
  color: white;
  text-align: center;
  letter-spacing: 5px;
  font-size: 22px;
}

.btn {
  display: inline-block;
  border: 0;
  padding: 13px 23px;
  border-radius: 30px;
  background: linear-gradient(100deg, #ffe6a8, #f2a9d3);
  color: #301533;
  font-weight: 900;
  box-shadow: 0 6px 24px #f6b5d52b;
  transition: transform .2s, filter .2s;
}

.btn:active { transform: scale(.96); }

.btn:hover { filter: brightness(1.08); }

#unlockBtn { width: 100%; }

#error {
  min-height: 25px;
  color: #ffb8d1;
  font-size: 13px;
}

#mainContent {
  position: relative;
  z-index: 1;
  display: none;
  padding-bottom: 55px;
}

section {
  width: min(900px, 100%);
  margin: auto;
  padding: 45px 20px;
  text-align: center;
}

.hero {
  min-height: 94vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.crown { font-size: 40px; }

.hero h1 {
  font-size: clamp(36px, 9vw, 66px);
  line-height: 1.5;
  margin: 10px 0;
  background: linear-gradient(100deg, #fff0bd, #ffacd5, #d8b8ff);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero p {
  max-width: 560px;
  line-height: 2.1;
  color: #e9d7f0;
}

.big-heart {
  font-size: 76px;
  filter: drop-shadow(0 0 25px #ff7eb4);
  animation: heartbeat 1.4s infinite;
}

@keyframes heartbeat {
  0%,100% { transform: scale(1); }
  15% { transform: scale(1.13); }
  30% { transform: scale(1); }
  45% { transform: scale(1.09); }
}

.panel {
  padding: 26px 20px;
  margin: 18px auto;
  border: 1px solid #f7d4ff24;
  border-radius: 25px;
  background: linear-gradient(145deg, #ffffff0c, #ffffff04);
  box-shadow: 0 12px 40px #00000016;
  text-align: right;
}

.panel h2 {
  text-align: center;
  color: var(--gold);
  margin-top: 0;
}

.letter {
  font-family: 'Amiri', Georgia, serif;
  font-size: 21px;
  line-height: 2.15;
  white-space: pre-line;
  color: #fff0fb;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 13px;
  margin-top: 22px;
}

.gift-card {
  min-height: 170px;
  padding: 20px 10px;
  border-radius: 20px;
  border: 1px solid #ffffff20;
  background: #ffffff08;
}

.gift-card .emoji { font-size: 38px; }

.gift-card h3 {
  color: var(--pink);
  font-size: 16px;
}

.gift-card p {
  color: #e7d8ed;
  font-size: 13px;
  line-height: 1.9;
}

.reveal {
  display: none;
  margin-top: 18px;
  padding: 20px;
  border-radius: 18px;
  background: #ffda9110;
  border: 1px solid #ffda9140;
  line-height: 2;
}

#songStatus {
  font-size: 13px;
  color: #e6d3ed;
  line-height: 2;
}

footer {
  text-align: center;
  color: #c9b5d5;
  font-size: 13px;
  padding: 20px;
}

.floating {
  position: fixed;
  bottom: -30px;
  z-index: 50;
  pointer-events: none;
  animation: rise 3.5s linear forwards;
}

@keyframes rise {
  0% { transform: translateY(0) rotate(0); opacity: 1; }
  100% { transform: translateY(-110vh) rotate(35deg); opacity: 0; }
}

#surpriseFinal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 200;
  padding: 25px;
  background: #10091df5;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow-y: auto;
}

.final-card { max-width: 500px; }

.final-card h1 {
  color: var(--gold);
  font-size: clamp(32px, 8vw, 54px);
}

.final-card p {
  line-height: 2.2;
  color: #f8e8f8;
}

@media(max-width: 560px) {
  section { padding: 32px 16px; }
  .cards { grid-template-columns: 1fr; }
  .gift-card { min-height: auto; }
  .letter { font-size: 19px; }
}

@media(prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
</style>
</head>

<body>
<div id="stars"></div>

<!-- شاشة كلمة السر -->
<div id="lockScreen">
  <div class="lock-card">
    <div class="lock-icon">🎁</div>
    <div class="gold" style="font-size:13px;letter-spacing:3px">
      A LITTLE SURPRISE FOR YOU
    </div>
    <h1 class="gold">فاطيما ❤️</h1>
    <p class="subtitle">
      فيه حاجة معمولة مخصوص عشانك يا أختي الحبيبة…
      <br>بس الهدية دي ليها مفتاح سري 🔐
    </p>

    <input id="password" type="password"
      inputmode="numeric" maxlength="8"
      placeholder="تاريخ ميلادك"
      autocomplete="off">

    <button class="btn" id="unlockBtn">
      افتحي هديتك يا فاطيما ✨
    </button>

    <p id="error" aria-live="polite"></p>
    <p style="font-size:12px;color:#c8b1d4">
      معمولة بكل الحب من أخوكي ❤️
    </p>
  </div>
</div>

<!-- حطي ملف الأغنية في نفس مجلد الموقع -->
<audio id="birthdaySong" src="kol-sana.mp3" preload="auto"
  loop></audio>

<main id="mainContent">

  <section class="hero">
    <div class="crown">👑✨</div>
    <div class="big-heart">💖</div>
    <p class="gold">النهارده مش يوم عادي أبدًا</p>
    <h1>كل سنة وإنتِ قلبي يا فاطيما</h1>
    <p>
      النهارده يوم ميلاد أختي وحبيبتي وقطعة من قلبي…
      اليوم اللي الدنيا فيه بقت أحلى بوجودك.
    </p>

    <button class="btn" onclick="goToLetter()">
      عندي كلام ليكي من قلبي 💌
    </button>

    <p id="songStatus">
      🎵 لو الأغنية مشتغلتش، اضغطي زر تشغيل الأغنية
    </p>
    <button class="btn" onclick="toggleSong()">
      🎵 تشغيل / إيقاف الأغنية
    </button>
  </section>

  <section id="letterSection">
    <div class="panel">
      <h2>💌 رسالة من زياد لفاطيما</h2>
      <div class="letter">بصي يا فاطيما…

أنا عارف إني مش دايمًا بعرف أقولك كل اللي جوايا، وممكن أزعلك مني ساعات، وممكن أكون عصبي معاكي أو أتكلم بطريقة تضايقك، بس عايزك تعرفي إن مهما حصل بينا، إنتِ غالية عندي بطريقة الكلام لوحده مش هيعرف يوصفها.

إنتِ مش مجرد أختي الصغيرة، إنتِ حتة مني، وإنتِ من الناس اللي مهما الدنيا أخدتني ومهما كبرت وانشغلت، هيفضل ليهم مكان جوايا محدش يقدر ياخده.

أنا يمكن أزعلك، ويمكن أختلف معاكي، ويمكن أقولك لأ على حاجات كتير، بس عمري ما هبقى عايز أشوفك مكسورة أو زعلانة. ولو في يوم حسّيتي إني قاسي عليكي، افتكري إنك أختي اللي بحبها، وإن خوفي عليكي ساعات بيخليني أتصرف بطريقة مش أحسن حاجة.

أنا مش عايزك تكبري وبس، أنا عايزك تكبري وإنتِ واثقة في نفسك، عارفة قيمتك، ومش مستنية من حد يقولك إنك تستاهلي الحب والفرحة. إنتِ تستاهلي كل حاجة حلوة، وتستاهلي ناس تحافظ على قلبك وتفرح لفرحتك وتكون جنبك وقت تعبك.

ونفسي لما الأيام تكبرنا، وتبقى ليكي حياتك وأحلامك وحكاياتك، تفضلي عارفة إن ليكي أخ مهما اتشغل أو اتعب، هيفضل يفرح بنجاحك، ويخاف عليكي، ويفتخر بيكي، ويتمنى يشوفك أحسن من أي حد.

يمكن أنا مش دايمًا الأخ المثالي، ومش كل مرة بعرف أختار الكلام الصح، بس صدقيني أنا بحبك بجد، وبفرح لما أشوفك مبسوطة، وحتى لما أزعلك، عمري ما بتمنى ليكي غير الخير.

في عيد ميلادك، مش هتمنالك بس سنة حلوة… أنا بتمنالك عمر كامل مليان راحة بال، وضحكة طالعة من قلبك، ونجاح يخليكي فخورة بنفسك، وأيام تعوضك عن أي يوم زعلتي فيه.

ربنا يحفظك ليا، ويبعد عنك كل شر، وما يورينيش فيكي حاجة توجع قلبي، ويخليني دايمًا سبب في فرحتك مش في زعلك.

وآخر حاجة عايزك تحفظيها كويس…

مهما كبرتي، ومهما بقيتي قوية ومستقلة، ومهما الدنيا خدت كل واحد في طريق، هتفضلي أختي الصغيرة اللي ليها مكان مخصوص في قلبي.

كل سنة وإنتِ طيبة يا فاطيما، وكل سنة وإنتِ منوّرة حياتنا، وكل سنة وأنا أخوكي اللي بيحبك حتى في الأيام اللي بتتخانقوا فيها على أتفه حاجة 😂❤️

بحبك يا أختي، وربنا يديمك نعمة في حياتي.

أخوكي،
زياد ❤️</div>
    </div>
  </section>

  <section>
    <h2 class="gold">🎁 عندي ليكي 3 هدايا صغيرة</h2>
    <p class="subtitle">اختاري كل هدية وافتحيها واحدة واحدة</p>

    <div class="cards">
      <div class="gift-card">
        <div class="emoji">💗</div>
        <h3>هدية الحب</h3>
        <button class="btn" onclick="reveal('gift1')">افتحيها</button>
        <div class="reveal" id="gift1">
          إنتِ أختي، ودي لوحدها مكانة محدش في الدنيا يقدر ينافسك عليها ❤️
        </div>
      </div>

      <div class="gift-card">
        <div class="emoji">🌟</div>
        <h3>هدية أمنية</h3>
        <button class="btn" onclick="reveal('gift2')">افتحيها</button>
        <div class="reveal" id="gift2">
          أتمنى أشوفك ناجحة ومبسوطة، وتحققي كل حاجة قلبك بيحلم بيها.
        </div>
      </div>

      <div class="gift-card">
        <div class="emoji">🤗</div>
        <h3>هدية وعد</h3>
        <button class="btn" onclick="reveal('gift3')">افتحيها</button>
        <div class="reveal" id="gift3">
          أوعدك إني هفضل أخوكي، حتى لو اتخانقنا على آخر قطعة شوكولاتة 😂🍫
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="panel" style="text-align:center">
      <div style="font-size:55px">🕯️🎂🎉</div>
      <h2>تمنّي أمنية يا فاطيما</h2>
      <p class="subtitle">
        غمّضي عينك لحظة، وتمنّي حاجة نفسك فيها من قلبك…
        وربنا يجعل أيامك كلها خير وفرحة.
      </p>
      <button class="btn" onclick="makeWish()">
        تمنّيت أمنيتي ✨
      </button>
      <div class="reveal" id="wishReveal">
        يا رب الأمنية دي تبقى حقيقة، وييجي يوم تفتكريه
        وتضحكي وتقولي: الحمد لله إنها حصلت ❤️
      </div>
    </div>
  </section>

  <section>
    <button class="btn" onclick="openFinal()">
      آخر مفاجأة ليكي يا فاطيما 💝
    </button>
  </section>

  <footer>
    اتعملت بكل الحب من زياد لأخته فاطيما ❤️
    <br>مش مجرد هدية… دي حتة من قلبي.
  </footer>
</main>

<!-- النهاية -->
<div id="surpriseFinal">
  <div class="final-card">
    <div style="font-size:65px">💖🎂👑</div>
    <h1>كل سنة وإنتِ قلبي</h1>
    <p>
      يا فاطيما، لو أقدر أهديكي حاجة أكبر من الكلام،
      كنت ههديكي أيام حلوة من غير زعل،
      وقلب مطمّن من غير خوف،
      وضحكة متفارقش وشك أبدًا.
      <br><br>
      إنتِ أختي، ودي واحدة من أجمل النعم اللي ربنا رزقني بيها.
      <br><br>
      كل سنة وإنتِ طيبة يا روح أخوكي ❤️
      <br><br>
      <strong style="color:#ffda91">من زياد… لأغلى فاطيما في الدنيا.</strong>
    </p>
    <button class="btn" onclick="closeFinal()">ارجعي للمفاجأة 💗</button>
    <button class="btn" onclick="celebrate()">احتفال تاني 🎉</button>
  </div>
</div>

<script>
/* نجوم الخلفية */
const stars = document.getElementById('stars');

for (let i = 0; i < 75; i++) {
  const star = document.createElement('span');
  star.className = 'star';
  star.textContent = Math.random() > .7 ? '✦' : '·';
  star.style.left = Math.random() * 100 + '%';
  star.style.top = Math.random() * 100 + '%';
  star.style.fontSize = (8 + Math.random() * 14) + 'px';
  star.style.animationDelay = Math.random() * 3 + 's';
  stars.appendChild(star);
}

const passwordInput = document.getElementById('password');
const errorMessage = document.getElementById('error');
const song = document.getElementById('birthdaySong');
const songStatus = document.getElementById('songStatus');

function unlockGift() {
  if (passwordInput.value !== '20102011') {
    errorMessage.textContent =
      'الباسورد مش مظبوط يا فاطيما، جرّبي تاني ❤️';
    passwordInput.value = '';
    passwordInput.focus();
    return;
  }

  errorMessage.textContent = '';
  const lock = document.getElementById('lockScreen');
  lock.style.opacity = '0';

  setTimeout(() => {
    lock.style.display = 'none';
    document.getElementById('mainContent').style.display = 'block';
    window.scrollTo(0, 0);
    celebrate();
    song.play().then(() => {
      songStatus.textContent = '🎵 الأغنية شغالة مخصوص عشانك يا فاطيما ❤️';
    }).catch(() => {
      songStatus.textContent =
        '🎵 اضغطي تشغيل الأغنية عشان تبدأ.';
    });
  }, 750);
}

document.getElementById('unlockBtn').addEventListener('click', unlockGift);

passwordInput.addEventListener('keydown', event => {
  if (event.key === 'Enter') unlockGift();
});

function toggleSong() {
  if (song.paused) {
    song.play().then(() => {
      songStatus.textContent = '🎵 الأغنية شغالة ❤️';
    }).catch(() => {
      songStatus.textContent =
        'مش لاقي ملف الأغنية. تأكدي إن kol-sana.mp3 موجود جنب index.html.';
    });
  } else {
    song.pause();
    songStatus.textContent = 'الأغنية متوقفة مؤقتًا 🎵';
  }
}

song.addEventListener('error', () => {
  songStatus.textContent =
    'ملف الأغنية مش موجود. ضعي kol-sana.mp3 في نفس مجلد الموقع.';
});

function goToLetter() {
  document.getElementById('letterSection').scrollIntoView({
    behavior: 'smooth'
  });
}

function reveal(id) {
  const box = document.getElementById(id);
  box.style.display = box.style.display === 'block' ? 'none' : 'block';
  if (box.style.display === 'block') burst(12);
}

function makeWish() {
  document.getElementById('wishReveal').style.display = 'block';
  burst(35);
}

function openFinal() {
  document.getElementById('surpriseFinal').style.display = 'flex';
  burst(55);
}

function closeFinal() {
  document.getElementById('surpriseFinal').style.display = 'none';
}

function floatingEmoji(emoji) {
  const el = document.createElement('div');
  el.className = 'floating';
  el.textContent = emoji;
  el.style.left = Math.random() * 95 + '%';
  el.style.fontSize = (18 + Math.random() * 25) + 'px';
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 3600);
}

function burst(count = 25) {
  const emojis = ['💖', '✨', '💕', '🌟', '💗', '🎉'];
  for (let i = 0; i < count; i++) {
    setTimeout(() => {
      floatingEmoji(emojis[Math.floor(Math.random() * emojis.length)]);
    }, i * 55);
  }
}

function celebrate() {
  burst(35);
}
</script>

</body>
</html>

